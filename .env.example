# ---------------------------------------------------------------------------
# SmartCar environment template
# Copy this file to `.env` (backend/.env or project root) and adjust values.
# Every value below is a default — the app runs without a .env file at all.
# ---------------------------------------------------------------------------

# FastAPI / HTTP
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Comma separated list of origins allowed by CORS, or * for any origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=smartcar
MONGO_COLLECTION=predictions

# Model artifacts (relative paths resolve against the backend/ directory)
MODEL_PATH=models/smartcar_best_model.joblib
DATASET_PATH=data/Car details v3.csv

# Reference year used to derive car_age = REFERENCE_YEAR - model_year.
# Must stay 2026 to match the training-time feature derivation.
REFERENCE_YEAR=2026
